      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ClearWell NC uses your location once to find your census tract and show your area's well-water risk. Your location is not saved unless you choose Save as My Well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ClearWell NC usa su ubicación una sola vez para encontrar su sector censal y mostrar el riesgo del agua de pozo de su zona. Su ubicación no se guarda a menos que elija Guardar como Mi Pozo."
          }
        }
      }
    }
