      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ClearWell NC uses your location to find your census tract, show your area's water risk, and find water help nearby. Your location is not saved unless you choose to save it."
