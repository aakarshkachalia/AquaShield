    },
    "That location is outside North Carolina. ClearWell NC only has well data for North Carolina." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Esa ubicación está fuera de Carolina del Norte. ClearWell NC solo tiene datos de pozos de Carolina del Norte."
