    "A baby under 6 months lives here" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En esta casa vive un bebé menor de 6 meses"
          }
        }
      }
    },
    "A gradient-boosted model learns from rock types, location and nearby test results, then estimates every tract in the state, including tracts with few or no tests." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un modelo de gradient boosting aprende de los tipos de roca, la ubicación y los resultados de análisis cercanos, y luego estima cada sector censal del estado, incluidos los sectores con pocos análisis o ninguno."
          }
        }
      }
    },
    "A model that fills the gaps" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un modelo que llena los vacíos"
          }
        }
      }
    },
    "A point-of-use filter certified to NSF/ANSI 53 for lead; replace old brass fittings or lead solder where possible." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un filtro de punto de uso certificado según NSF/ANSI 53 para plomo; reemplace las conexiones viejas de latón o la soldadura de plomo cuando sea posible."
          }
        }
      }
    },
